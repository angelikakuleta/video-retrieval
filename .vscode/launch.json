{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Environment check (check_gpu.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_gpu.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Experiment (choose configuration)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_experiment.py",
      "args": ["--config", "configs/${input:config}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "config",
      "type": "promptString",
      "description": "Name of the configuration file in configs/, e.g. E5-C.yaml",
      "default": "E1-A.yaml"
    }
  ]
}
